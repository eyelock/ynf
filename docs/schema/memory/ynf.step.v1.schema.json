{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyelock.github.io/ynf/schema/memory/ynf.step.v1.schema.json",
  "title": "ynf.step.v1",
  "description": "The data of an episodic memory ynf writes after a run (ADR-008). Its subject is the item key. ynm stores it as an object it does not interpret.",
  "type": "object",
  "required": ["item", "lane", "run_id", "outcome"],
  "properties": {
    "item": { "type": "string", "description": "The item key." },
    "lane": { "type": "string" },
    "run_id": { "type": "string" },
    "outcome": { "enum": ["converged", "budget", "stuck", "tamper", "operator_error", "error", "aborted"] },
    "changed": { "type": "integer", "minimum": 0, "description": "Files the run changed." },
    "state": { "type": "string", "description": "The item's state after the decision." }
  }
}
