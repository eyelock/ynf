# The sandbox's settings. Copy this file to sandbox.env (which git ignores) and fill it in.
# Plain KEY=value lines, no quotes: make reads this file.

# The GitHub user or organisation the two sandbox repositories are created under. Required.
# Your token (gh auth token) needs the repo and delete_repo scopes for it:
#   gh auth refresh -s delete_repo
SANDBOX_OWNER=

# The repositories' names, and their visibility.
SANDBOX_NAME=ynf-sandbox
SANDBOX_FACTORY=ynf-sandbox-factory
SANDBOX_VISIBILITY=private

# Terraform's state is a local file (terraform/terraform.tfstate) unless you choose S3, which keeps
# it beyond this machine and locks it. Only then is AWS needed.
# SANDBOX_STATE=s3
# SANDBOX_STATE_BUCKET=
# SANDBOX_STATE_KEY=sandbox/terraform.tfstate
# SANDBOX_STATE_REGION=
# AWS_PROFILE=
