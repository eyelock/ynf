{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyelock.github.io/ynf/schema/sandbox-fixtures.schema.json",
  "title": "ynf sandbox fixtures",
  "description": "The issues and pull requests the sandbox starts with, and what ynf is expected to do with each. Read by sandbox/terraform.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fixtures"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "body", "labels", "lane", "expect"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "Stable name; the Terraform resource key."
        },
        "kind": { "enum": ["issue", "pull_request"] },
        "title": { "type": "string", "minLength": 1 },
        "body": {
          "type": "string",
          "pattern": "^fixtures/[a-z0-9-]+\\.md$",
          "description": "Markdown file, relative to sandbox/."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(ynf:[a-z-]+|pkg:[A-Za-z0-9._/-]+)$"
          },
          "uniqueItems": true,
          "description": "ynf:<lane label> routes the fixture; pkg:<path> scopes sensors to it."
        },
        "lane": {
          "type": "string",
          "description": "The lane in seed/.agents/factory/lanes.yaml expected to pick this fixture up."
        },
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "files"],
          "properties": {
            "branch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
            "files": {
              "type": "string",
              "description": "Directory, relative to sandbox/, whose tree is committed on top of main on the branch."
            }
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "checks"],
          "properties": {
            "result": {
              "enum": ["in_review", "escalated", "quarantined", "ignored", "done", "any"],
              "description": "The work item's state once ynf has nothing more to do without a human."
            },
            "signatures": {
              "type": "array",
              "items": { "type": "string", "pattern": "^sig/" },
              "description": "Failure signatures the item's log must contain."
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" },
              "description": "What a reviewer of the run confirms, in words."
            }
          }
        }
      },
      "if": { "properties": { "kind": { "const": "pull_request" } } },
      "then": { "required": ["pull_request"] },
      "else": { "not": { "required": ["pull_request"] } }
    }
  }
}
